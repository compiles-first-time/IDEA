# Copy to .env.local and fill in. NEVER commit real secrets.

# Auth.js session secret — generate with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# GitHub OAuth App — github.com → Settings → Developer settings → OAuth Apps → New
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
#   (add a second OAuth app, or extra callback, for https://<your-app>.vercel.app/... in prod)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Comma-separated GitHub usernames allowed to sign in.
# FAIL-CLOSED: if empty, nobody can sign in.  e.g. ALLOWED_LOGINS=yourname,teammate
ALLOWED_LOGINS=

# Optional: override the chat model id (must be one your ANTHROPIC_API_KEY can access)
# IDEA_CHAT_MODEL=claude-sonnet-4-5
