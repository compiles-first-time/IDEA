# Copy to .env.local and fill in. NEVER commit real secrets.

# Auth.js session secret — generate with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# GitHub OAuth App — github.com → Settings → Developer settings → OAuth Apps → New
#   Homepage URL:               http://localhost:4300
#   Authorization callback URL: http://localhost:4300/api/auth/callback/github
# The port must match the one IDEA runs on, or sign-in fails with a redirect_uri
# mismatch. 4300 is the default; if you set PORT, use that number in both URLs.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Comma-separated GitHub usernames allowed to sign in.
# FAIL-CLOSED: if empty, nobody can sign in.  e.g. ALLOWED_LOGINS=yourname,teammate
ALLOWED_LOGINS=

# Optional: override the chat model id. Must be one of the ids in config/models.json
# and one your ANTHROPIC_API_KEY can access.
# IDEA_CHAT_MODEL=claude-sonnet-5

# Optional: keys for the other bundled providers (config/models.json).
# A model whose provider has no key is simply never routed to.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=

# Hosted mode (FR-15, docs/architecture/12-hosted-mode.md). Never needed on a
# machine you own. On Vercel it turns on automatically (VERCEL=1); IDEA_HOSTED=1
# forces it on any other serverless host. Hosted mode disables everything
# disk-bound and expects each signed-in user to bring their own provider keys.
# IDEA_HOSTED=1
